# --- Server -----------------------------------------------------------------------------
# Public URL of the app (invite links, password reset links). With adapter-node it is also
# used for SvelteKit's CSRF origin check, so in production it MUST be the real https URL.
ORIGIN=http://localhost:5173
# Behind nginx + Cloudflare (produzione/nginx/splitto.conf) the real visitor IP, used by the
# rate limiter, arrives in X-Real-IP:
# ADDRESS_HEADER=X-Real-IP
# Port used by `npm start` (adapter-node). Default 3000.
PORT=3000

# --- Database ---------------------------------------------------------------------------
# Path of the SQLite file. The folder is created automatically.
DATABASE_PATH=./data/splitto.db
# Apply pending migrations automatically when the server starts (true/false).
DB_AUTO_MIGRATE=true

# --- Uploads ----------------------------------------------------------------------------
# Folder for receipts and avatars (included in backups).
UPLOAD_DIR=./data/uploads
# Max upload size in megabytes.
UPLOAD_MAX_MB=5
# adapter-node rejects request bodies above this size (default 512K, too small for photos).
# Keep it a bit above UPLOAD_MAX_MB, and keep nginx client_max_body_size in line.
BODY_SIZE_LIMIT=6M

# --- Sessions & security ----------------------------------------------------------------
# Session lifetime in days (sliding: renewed automatically while the user is active).
SESSION_DAYS=30
# Session cookies are `secure` in production. Set to false ONLY to test a build over plain
# HTTP on a non-localhost address (never in real production).
COOKIE_SECURE=true
# Multiplies the login/registration rate limits (1 = default; the e2e tests use 100).
RATE_LIMIT_SCALE=1

# --- Background jobs --------------------------------------------------------------------
# In-process job that generates recurring expenses (every 15 min). Disable on extra instances.
JOBS_ENABLED=true

# --- Login with Google (optional) -----------------------------------------------------
# The button appears on /login and /register only when both values are set.
# Google: OAuth client of type "Web application" (console.cloud.google.com → Credentials).
# Authorized redirect URI: <ORIGIN>/login/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Web Push (generate with `npm run vapid:generate`) ---------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Service worker ---------------------------------------------------------------------
# Set to "true" to enable the service worker while running `npm run dev`.
PUBLIC_SW_IN_DEV=false

# --- Backups ----------------------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4

# --- Search engines ---------------------------------------------------------------------
# Optional: the "content" value of the HTML-tag verification from Google Search Console
# (alternatively verify the domain with a DNS TXT record and leave this empty).
PUBLIC_GOOGLE_SITE_VERIFICATION=
