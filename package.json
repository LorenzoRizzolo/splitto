{
	"name": "splitto",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node --env-file-if-exists=.env build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
		"db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
		"db:studio": "drizzle-kit studio",
		"icons": "tsx scripts/generate-icons.ts",
		"og": "tsx scripts/generate-og.ts",
		"vapid:generate": "tsx scripts/vapid-generate.ts",
		"backup": "tsx --env-file-if-exists=.env scripts/backup.ts",
		"restore": "tsx --env-file-if-exists=.env scripts/restore.ts",
		"screenshots": "tsx scripts/screenshots.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.0",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^22",
		"@types/qrcode": "^1.5.6",
		"@types/three": "^0.186.0",
		"@types/web-push": "^3.6.4",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"sharp": "^0.35.5",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@node-rs/argon2": "^2.2.2",
		"@threlte/core": "^8.6.1",
		"@threlte/extras": "^9.22.2",
		"arctic": "^3.7.0",
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.4",
		"qrcode": "^1.5.4",
		"tar": "^7.5.22",
		"three": "^0.186.1",
		"web-push": "^3.6.7",
		"zod": "^4.6.7"
	},
	"allowScripts": {
		"better-sqlite3@13.0.3": true,
		"esbuild@0.18.20": true,
		"esbuild@0.25.12": true,
		"esbuild@0.28.2": true,
		"fsevents": false
	}
}
